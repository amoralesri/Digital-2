# Bare-metal firmware build products.
Litex/**/*.o
Litex/**/*.d
Litex/**/*.elf
Litex/**/*.bin
Litex/**/*.lst

# Local one-off simulation outputs outside the active WS2812 scope.
femtoRV/basic/rtl/cores/ws2812/a.out
femtoRV/basic/rtl/cores/ws2812/*.vcd

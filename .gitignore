.venv-litex/

# LiteX generated build trees and simulation products.
Litex/build/
Litex/*.vpp
Litex/*_PS.vpp
Litex/*.vcd
Litex/*.init
Litex/**/*.vvp
Litex/**/*.vcd
Litex/**/__pycache__/
